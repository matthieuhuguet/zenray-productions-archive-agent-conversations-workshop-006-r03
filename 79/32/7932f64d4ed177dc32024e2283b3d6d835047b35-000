.md / .db.json / .media.json /\n// .img.json / .canvas.json / .embed.json. Zéro régression : tout champ ancien est conservé.\nimport { typeOfPath, stripLeafExt, legacyFlags } from './node.js'\n\n// Arbre Notion : X (contenu) et le dossier X/ fusionnés sous le même nom. node.type = type du contentPath.\nexport function buildTree(paths) {\n  const root = { name: '', children: {}, contentPath: null, type: 'folder' }\n  for (const p of paths) {\n    const segs = stripLeafExt(p.replace(/^pages\\//, '')).split('/')\n    let node = root\n    segs.forEach((seg, i) => {\n      node.children[seg] = node.children[seg] || { name: seg, children: {}, contentPath: null, type: 'folder' }\n      node = node.children[seg]\n      if (i === segs.length - 1) { node.contentPath = p; node.type = typeOfPath(p) }\n    })\n  }\n  return root\n}\n\n// Entrées directement sous `dir`, fusionnant page (X.md) + dossier (X/) + bases/médias (X.db.json…) sous le même nom.\nexport function entriesOf(paths, dir) {\n  const prefix = dir.endsWith('/') ? dir : dir + '/'\n  const map = {}\n  for (const p of (paths || [])) {\n    if (!p.startsWith(prefix)) continue\n    const rest = stripLeafExt(p.slice(prefix.length))\n    if (!rest) continue\n    const seg = rest.split('/')[0]\n    const isLeaf = rest.indexOf('/') === -1\n    map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg, type: 'folder', isDb: false, isMedia: false, isImage: false }\n    if (isLeaf) {\n      const type = typeOfPath(p)\n      map[seg].contentPath = p\n      map[seg].type = type\n      Object.assign(map[seg], legacyFlags(type))\n    } else {\n      map[seg].hasKids = true\n    }\n  }\n  return Object.values(map).sort((a, b) => a.name.localeCompare(b.name))\n}\n"}}
