  // 2) intervalle demandé (Range: bytes=start-end). Sans Range -> fenêtre depuis 0.\n    70\t    const range = req.headers.range\n    71\t    let start = 0, end = size - 1, isRange = false\n    72\t    if (range) {\n    73\t      const mt = /bytes=(\\d*)-(\\d*)/.exec(range)\n    74\t      if (mt) {\n    75\t        isRange = true\n    76\t        if (mt[1]) start = parseInt(mt[1], 10)\n    77\t        if (mt[2]) end = parseInt(mt[2], 10)\n    78\t      }\n    79\t    }\n    80\t    if (start >= size) { res.setHeader('Content-Range', `bytes */${size}`); return res.status(416).end() }\n    81\t    // borne la fenêtre servie (réponse <= MAX_WINDOW) ; le lecteur redemandera la suite\n    82\t    end = Math.min(end, size - 1, start + MAX_WINDOW - 1)\n    83\t\n    84\t    // 3) chunks couvrant [start, end]\n    85\t    const first = Math.floor(start / chunkSize)\n    86\t    const last = Math.floor(end / chunkSize)\n    87\t    const buffers = []\n    88\t    for (let i = first; i <= last; i++) {\n    89\t      const part = m.parts[i]\n    90\t      const binPath = objectParts ? null : m.dir + '/' + part + '.bin'\n    91\t      if (isEnc) {\n    92\t        // ciphertext public via jsDelivr -> déchiffrement avec l'iv du chunk i (manifest.ivs[i]).\n    93\t        const cr = objectParts ? await fetch(part.url) : await cdnBin(m.cdnRepo, m.cdnCommit, binPath)\n    94\t        if (!cr.ok) return res.status(502).end()\n    95\t        try { buffers.push(decryptChunk(Buffer.from(await cr.arrayBuffer()), objectParts ? part.iv : m.ivs[i], key)) }\n    96\t        catch { return res.status(502).end() } // mauvaise clé / tag invalide\n    97\t      } else {\n    98\t        // raw hors quota ; chunkRepo = shard privé indiqué par le manifest, sinon zenray-data (REPO).\n    99\t        const cr = await rawBin(token, chunkRepo || REPO.split('/')[1], binPath)\n   100\t        if (!cr.ok) return res.status(502).end()\n   101\t        buffers.push(Buffer.from(await cr.arrayBuffer()))\n