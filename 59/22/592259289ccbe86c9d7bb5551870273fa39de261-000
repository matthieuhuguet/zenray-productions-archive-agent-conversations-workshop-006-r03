> Buffer.from(s || '', 'base64').toString('utf8')\n    16\tfunction gh(token, path, accept) {\n    17\t  return fetch(`https://api.github.com/repos/${REPO}/${path}`, {\n    18\t    headers: { Authorization: `Bearer ${token}`, Accept: accept || 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },\n    19\t  })\n    20\t}\n    21\t// QUOTA : les parts .bin sont adressées par contenu (immuables) -> on les lit via raw.githubusercontent.com\n    22\t// (NE COMPTE PAS dans la limite REST 5000/h). Sans ça, chaque seek vidéo/audio chunké tapait l'API contents\n    23\t// (une fenêtre de 4 Mo = plusieurs GET quota) -> lecture de bout en bout = dizaines de requêtes -> 403, lecteur figé.\n    24\t// Le manifest .media.json (1 lecture par ouverture) reste sur l'API contents.\n    25\tfunction rawBin(token, repo, binPath) {\n    26\t  return fetch(`https://raw.githubusercontent.com/${OWNER}/${repo}/${BRANCH}/${encodeURI(binPath)}`, {\n    27\t    headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' },\n    28\t  })\n    29\t}\n    30\t// CHUNK PUBLIC CHIFFRÉ (modèle \"public + chiffré + jsDelivr\") : le ciphertext vit sur un repo PUBLIC, servi par\n    31\t// jsDelivr (CDN, hors quota). On le récupère par son pin de commit (immuable), puis on le déchiffre côté serveur.\n    32\tfunction cdnBin(repo, commit, binPath) {\n    33\t  return fetch(`https://cdn.jsdelivr.net/gh/${OWNER}/${repo}${commit ? '@' + commit : ''}/${encodeURI(binPath)}`)\n    34\t}\n    35\t// AES-256-GCM : le ciphertext WebCrypto = data || tag(16o). Node sépare le tag (setAuthTag) avant de déchiffrer.\n    36\tfunction decryptChunk(ctBuf, ivB64, key) {\n    37\t  const iv = Buffer.from(ivB64 || '', 'base64')\n    38\t  const tag = ctBuf.subarray(ctBuf.length - 16)\n    39\t  const data = ctBuf.subarray(0, ctBuf.length - 16)\n    40\t  const d = createDecipheriv('aes-256-gcm', key, iv)\n    41\t  d.setAuthTag(tag)\n    42\t  return Buffer.concat([d.update(data), d.final()])\