,\n   133\t    body: JSON.stringify(payload),\n   134\t  }).then((x) => x.json()).catch(() => null)\n   135\t}\n   136\t\n   137\t// POST /api/upload-shard (binary to shard).\n   138\t// RATE-LIMIT (2026-07-02): several parallel imports (captureFiles, FILE_CONCURRENCY=4) sometimes\n   139\t// trip GitHub's anti-abuse on concurrent commits. The server already retries internally (up to\n   140\t// ~20s, see server/upload-shard.js ghRetry); if it still gives up it returns {rateLimited:true,\n   141\t// resetAt}. Here we arm the SAME banner as reads (window.__zrMarkRateLimited, wired in App.jsx)\n   142\t// then wait until resetAt (capped at 90s so an import never blocks forever) before retrying ONCE.\n   143\t// Result: an import that hits anti-abuse pauses visibly then resumes by itself instead of failing.\n   144\texport async function shardApi(payload) {\n   145\t  const r = await shardApiOnce(payload)\n   146\t  if (r && r.rateLimited) {\n   147\t    try { window.__zrMarkRateLimited && window.__zrMarkRateLimited(r.resetAt) } catch {}\n   148\t    const waitMs = Math.min(Math.max(0, Number(r.resetAt) - Date.now()), 90000)\n   149\t    await sleep(waitMs + 300)\n   150\t    return shardApiOnce(payload)\n   151\t  }\n   152\t  return r\n   153\t}\n   154\t\n   155\t// Get the active shard (repo with room) of the (kind, vis) family.\n   156\t// Without kind/vis -> exact old flow (img/private). With them -> generic family.\n   157\tasync function activeShard(kind, vis, need) {\n   158\t  const payload = { action: 'active-shard' }\n   159\t  if (kind && vis) { payload.kind = kind; payload.vis = vis; if (need) payload.need = need }\n   160\t  const r = await shardApi(payload)\n   161\t  if (!r || r.error || !r.repo) throw new Error('active-shard: ' + ((r && r.error) || 'fail'))\n   162\t  return r.repo\n   163\t}\n   164\t\n   165\t// P2 — GLOBAL semaphore for GitHub blob writes. When several files import IN PARALLEL\n   166\t// (captureFiles), each potentially pushing up