<Icon name=\"square.grid.2x2\" size={14} color={canvasMode ? '#fff' : t.textSecondary} />{canvasMode ? 'Canvas (libre)' : 'Mode Canvas'}</button>\n   303\t    </div>\n   304\t  )\n   305\t  if (canvasMode) return (\n   306\t    <>\n   307\t      {toolbar}\n   308\t      <div style={{ position: 'relative', minHeight: '160vh', width: '100%' }}>\n   309\t        {blocks.map(([id, node]) => <DraggableBlock key={id} id={id} canvas={canvas} setPos={setPos}>{node}</DraggableBlock>)}\n   310\t      </div>\n   311\t    </>\n   312\t  )\n   313\t  return (\n   314\t    <>\n   315\t      {toolbar}\n   316\t      {blocks.map(([id, node]) => <React.Fragment key={id}>{node}</React.Fragment>)}\n   317\t      <div style={{ color: t.textSecondary, fontSize: 12, fontFamily: FONTS.mono, marginTop: 44, borderTop: `1px solid ${t.border}`, paddingTop: 14 }}>\n   318\t        ZenRayProgress · {allObjs().length} objectifs · source : Memory/LifeOS/objectives.json\n   319\t      </div>\n   320\t    </>\n   321\t  )\n   322\t}\n   323\t\n   324\tfunction Overall({ t, value, done, total, theme }) {\n   325\t  return (\n   326\t    <div style={{ ...card(t), display: 'flex', gap: 24, alignItems: 'center', flexWrap: 'wrap', marginBottom: 14, boxShadow: SHADOWS.apple }}>\n   327\t      <div style={{ fontFamily: FONTS.mono, fontSize: 46, fontWeight: 700, minWidth: 110, background: PALETTE.gradient, WebkitBackgroundClip: 'text', backgroundClip: 'text', color: 'transparent' }}>{pc(value)}%</div>\n   328\t      <div style={{ flex: 1, minWidth: 220 }}>\n   329\t        <Bar t={t} value={value} />\n   330\t        <div style={{ fontFamily: FONTS.mono, fontSize: 12.5, color: t.textSecondary, marginTop: 9 }}>{done} / {total} étapes franchies</div>\n   331\t      </div>\n   332\t      {theme && <div style={{ flexBasis: '100%', fontFamily: FONTS.serif, fontSize: 15, color: t.textPrimary, borderLeft: `3px solid ${PALETTE.primary}`, paddingLeft: 14, marginTop: 4 }}>{theme}</div>}\n   333\t    </div>\n   334\t  )\n   335\t}\n   336\tfunction Bar({ t, value, height = 10 }) {\n   337\t  return <div style={{ height, borderRadius: 99, background: t.border, overflow: 'hidden' }}><div style={{ height: '100%', width: `${pc(value)}%`, borderRadius: 99, background: PALETTE.gradient, transition: TRANSITIONS.smooth }} /></div>\n   338\t}\n   339\t\n   340\tfunction Priority({ t, syn }) {\n   341\t  const tp = syn.top_priority || {}; const cm = syn.choice_menu || {}\n   342\t  const opts = [{ k: 'x', name: 'X · dur', col: PALETTE.red, o: cm.x }, { k: 'y', name: 'Y · moyen', col: PALETTE.primary, o: cm.y }, { k: 'z', name: 'Z · facile', col: PALETTE.green, o: cm.z }].filter((x) => x.o)\n   343\t  if (!tp.title) return null\n   344\t  return (\n   345\t    <div style={{ ...card(t), border: `1px solid ${PALETTE.primary}`, marginBottom: 16, boxShadow: SHADOWS.glow }}>\n   346\t      <SectionLabel t={t} color={PALETTE.primary}>Priorité maintenant</SectionLabel>\n   347\t      <div style={{ fontFamily: FONTS.serif, fontSize: 20, fontWeight: 600 }}>{tp.title}</div>\n   348\t      <div style={{ color: t.textSecondary, fontFamily: FONTS.mono, fontSize: 12, margin: '4px 0 8px' }}>{tp.domain}</div>\n   349\t      {tp.why_now && <div style={{ opacity: 0.92, lineHeight: 1.55 }}>{tp.why_now}</div>}\n   350\t      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(240px,1fr))', gap: 12, marginTop: 14 }}>\n   351\t        {opts.map((opt) => (\n   352\t          <div key={opt.k} style={{ background: t.bg, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 14 }}>\n   353\t            <span style={{ display: 'inline-block', fontFamily: FONTS.mono, fontSize: 10.5, fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase', color: opt.col, border: `1px solid ${opt.col}`, borderRadius: 99, padding: '2px 9px', marginBottom: 9 }}>{opt.name} · +{opt.o.advance_pct}%</span>\n   354\t            <div style={{ fontWeight: 600, marginBottom: 4 }}>{opt.o.label}</div>\n   355\t            <div style={{ color: t.textSecondary, fontSize: 13, lineHeight: 1.5 }}>{opt.o.action}</div>\n   356\t          </div>\n   357\t        ))}\n   358\t      </div>\n   359\t    </div>\n   360\t  )\n   361\t}\n   362\t\n   363\t/* ───────── Week calendar ───────── */\n   364\tfunction WeekCalendar({ t, cards, today, onDropObj, onMoveCard, onOpen, onDelCard, addImages, onAddBlank }) {\n   365\t  const [offset, setOffset] = useState(0)\n   366\t  const start = mondayOf(new Date()); start.setDate(start.getDate() + offset * 7)\n   367\t  const days = Array.from({ length: 7 }, (_, i) => { const d = new Date(start); d.setDate(d.getDate() + i); return d })\n   368\t  const label = `${days[0].getDate()} ${MONTHS_SHORT[days[0].getMonth()]} — ${days[6].getDate()} ${MONTHS_SHORT[days[6].getMonth()]}`\n   369\t  return (\n   370\t    <div style={{ ...card(t), marginBottom: 16 }}>\n   371\t      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12, flexWrap: 'wrap', gap: 8 }}>\n   372\t        <SectionLabel t={t} color={t.textSecondary} nomargin>Semaine — glisse un objectif (ou une image) sur un jour</SectionLabel>\n   373\t        <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>\n   374\t          <button style={btn(t)} onClick={() => setOffset(offset - 1)}>‹</button>\n   375\t          <span style={{ fontFamily: FONTS.mono, fontSize: 12, color: t.textSecondary, minWidth: 150, textAlign: 'center' }}>{label}{offset === 0 ? ' · cette semaine' : ''}</span>\n   376\t          <button style={btn(t)} onClick={() => setOffset(offset + 1)}>›</button>\n   377\t          {offset !== 0 && <button style={btn(t)} onClick={() => setOffset(0)}>auj.</button>}\n   378\t        </div>\n   379\t      </div>\n   380\t      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7,minmax(0,1fr))', gap: 8 }}>\n   381\t        {days.map((d, i) => (\n   382\t          <DayColumn key={i} t={t} dayName={DAYNAMES[i]} date={d} dateStr={ymd(d)} isToday={ymd(d) === today}\n   383\t            cards={cards.filter((c) => c.date === ymd(d))}\n   384\t            onDropObj={onDropObj} onMoveCard={onMoveCard} onOpen={onOpen} onDelCard={onDelCard} addImages={addImages} onAddBlank={onAddBlank} />\n   385\t        ))}\n   386\t      </div>\n   387\t    </div>\n   388\t  )\n   389\t}\n   390\tfunction DayColumn({ t, dayName, date, dateStr, isToday, cards, onDropObj, onMoveCard, onOpen, onDelCard, addImages, onAddBlank }) {\n   391\t  const [over, setOver] = useState(false)\n   392\t  const handleDrop = (e) => {\n   393\t    e.preventDefault(); setOver(false)\n   394\t    if (e.dataTransfer.files && e.dataTransfer.files.length) {\n   395\t      const id = onDropObj({ obj: { id: null, title: 'Image' }, domain: '' }, dateStr) // create blank card then attach\n   396\t      if (id) addImages(id, e.dataTransfer.files)\n   397\t      return\n   398\t    }\n   399\t    let p; try { p = JSON.parse(e.dataTransfer.getData('text/plain')) } catch { return }\n   400\t    if (p.kind === 'obj') onDropObj({ obj: { id: p.objId, title: p.title }, domain: p.domain }, dateStr)\n   401\t    else if (p.kind === 'card') onMoveCard(p.cardId, dateStr)\n   402\t  }\n   403\t  return (\n   404\t    <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={() => setOver(false)} onDrop={handleDrop}\n   405\t      style={{ background: isToday ? PALETTE.primarySoft : t.bg, border: `1px solid ${over ? PALETTE.primary : t.border}`, borderRadius: RADII.md, padding: 8, minHeight: 150, display: 'flex', flexDirection: 'column', gap: 6, boxShadow: over ? SHADOWS.glow : 'none', transition: TRANSITIONS.base }}>\n   406\t      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline' }}>\n   407\t        <span style={{ fontFamily: FONTS.mono, fontSize: 11, color: isToday ? PALETTE.primary : t.textSecondary, fontWeight: 700 }}>{dayName}</span>\n   408\t        <span style={{ fontFamily: FONTS.mono, fontSize: 14, fontWeight: 700, color: isToday ? PALETTE.primary : t.textPrimary }}>{date.getDate()}</span>\n   409\t      </div>\n   410\t      <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 6 }}>\n   411\t        {cards.map((c) => <CalCard key={c.id} t={t} card={c} onOpen={onOpen} onDel={onDelCard} addImages={addImages} />)}\n   412\t      </div>\n   413\t      <button onClick={() => onAddBlank(dateStr)} style={{ ...btnGhost(t), fontSize: 12, padding: '4px 0' }}>+ carte</button>\n   414\t    </div>\n   415\t  )\n   416\t}\n   417\tfunction CalCard({ t, card, onOpen, onDel, addImages }) {\n   418\t  const [over, setOver] = useState(false)\n   419\t  const dragStart = (e) => { e.stopPropagation(); e.dataTransfer.setData('text/plain', JSON.stringify({ kind: 'card', cardId: card.id })) }\n   420\t  const drop = (e) => { if (e.dataTransfer.files && e.dataTransfer.files.length) { e.preventDefault(); e.stopPropagation(); setOver(false); addImages(card.id, e.dataTransfer.files) } }\n   421\t  return (\n   422\t    <div draggable onDragStart={dragStart} onClick={() => onOpen(card.id)}\n   423\t      onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); e.stopPropagation(); setOver(true) } }} onDragLeave={() => setOver(false)} onDrop={drop}\n   424\t      style={{ background: t.cardBg, border: `1px solid ${over ? PALETTE.primary : t.border}`, borderLeft: `3px solid ${PALETTE.primary}`, borderRadius: RADII.sm, padding: '7px 8px', cursor: 'pointer', boxShadow: SHADOWS.sm }}>\n   425\t      <div style={{ display: 'flex', justifyContent: 'space-between', gap: 6 }}>\n   426\t        <span style={{ fontSize: 12.5, lineHeight: 1.35, fontWeight: 600 }}>{card.title}</span>\n   427\t        <button onClick={(e) => { e.stopPropagation(); onDel(card.id) }} style={{ background: 'none', border: 'none', color: t.textSecondary, cursor: 'pointer', fontSize: 14, lineHeight: 1, padding: 0 }}>×</button>\n   428\t      </div>\n   429\t      {card.images && card.images[0] && <img src={card.images[0]} alt=\"\" style={{ width: '100%', borderRadius: 6, marginTop: 5, display: 'block', maxHeight: 90, objectFit: 'cover' }} />}\n   430\t      {card.domain && <div style={{ fontFamily: FONTS.mono, fontSize: 9.5, color: t.textSecondary, marginTop: 4, textTransform: 'uppercase', letterSpacing: 0.5 }}>{card.domain}</div>}\n   431\t      {card.note && <div style={{ fontSize: 11, color: t.textSecondary, marginTop: 3, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{card.note}</div>}\n   432\t    </div>\n   433\t  )\n   434\t}\n   435\t\n   436\t/* ───────── Notion-style right panel ───────── */\n   437\tfunction CardPanel({ t, card, onClose, editCard, delCard, addImages, removeImage }) {\n   438\t  const [over, setOver] = useState(false)\n   439\t  const drop = (e) => { e.preventDefault(); setOver(false); if (e.dataTransfer.files && e.dataTransfer.files.length) addImages(card.id, e.dataTransfer.files) }\n   440\t  return (\n   441\t    <aside style={{ position: 'fixed', top: 0, right: 0, width: 'min(420px,92vw)', height: '100vh', background: t.cardBg, borderLeft: `1px solid ${t.border}`, boxShadow: '-12px 0 40px rgba(0,0,0,0.18)', padding: '22px 22px 40px', overflowY: 'auto', zIndex: 50, animation: 'none' }}>\n   442\t      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>\n   443\t        <span style={{ fontFamily: FONTS.mono, fontSize: 11, color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 1 }}>Carte</span>\n   444\t        <button onClick={onClose} style={{ ...btn(t), padding: '5px 12px' }}>fermer ✕</button>\n   445\t      </div>\n   446\t      <input value={card.title} onChange={(e) => editCard(card.id, { title: e.target.value })}\n   447\t        style={{ width: '100%', background: 'transparent', color: t.textPrimary, border: 'none', borderBottom: `1px solid ${t.border}`, fontFamily: FONTS.serif, fontSize: 22, fontWeight: 600, padding: '4px 0 10px', outline: 'none' }} />\n   448\t      <div style={{ display: 'flex', gap: 12, alignItems: 'center', margin: '14px 0' }}>\n   449\t        <label style={{ fontFamily: FONTS.mono, fontSize: 11, color: t.textSecondary }}>Date</label>\n   450\t        <input type=\"date\" value={card.date} onChange={(e) => editCard(card.id, { date: e.target.value })}\n   451\t          style={{ background: t.bg, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '5px 8px', fontFamily: FONTS.sans, fontSize: 13 }} />\n   452\t        <span style={{ fontFamily: FONTS.serif, fontStyle: 'italic', color: t.textSecondary, fontSize: 13 }}>{fmtLong(card.date)}</span>\n   453\t      </div>\n   454\t      {card.domain && <div style={{ display: 'inline-block', fontFamily: FONTS.mono, fontSize: 10, color: PALETTE.primary, border: `1px solid ${PALETTE.primary}`, borderRadius: 99, padding: '2px 9px', marginBottom: 14, textTransform: 'uppercase' }}>{card.domain}</div>}\n   455\t      <textarea value={card.note} placeholder=\"Notes, détails, lien…\" onChange={(e) => editCard(card.id, { note: e.target.value })}\n   456\t        style={{ width: '100%', minHeight: 120, background: t.bg, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 12, fontFamily: FONTS.sans, fontSize: 14, lineHeight: 1.55, resize: 'vertical', outline: 'none' }} />\n   457\t      <SectionLabel t={t} color={t.textSecondary}>Images</SectionLabel>\n   458\t      <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={() => setOver(false)} onDrop={drop}\n   459\t        style={{ border: `1.5px dashed ${over ? PALETTE.primary : t.border}`, borderRadius: RADII.md, padding: 16, textAlign: 'center', color: t.textSecondary, fontSize: 13, background: over ? PALETTE.primarySoft : 'transparent', transition: TRANSITIONS.base }}>\n   460\t        Glisse des images ici\n   461\t        <label style={{ display: 'inline-block', marginLeft: 8, color: PALETTE.primary, cursor: 'pointer', textDecoration: 'underline' }}>\n   462\t          parcourir\n   463\t          <input type=\"file\" accept=\"image/*\" multiple style={{ display: 'none' }} onChange={(e) => addImages(card.id, e.target.files)} />\n   464\t        </label>\n   465\t        <div style={{ fontFamily: FONTS.mono, fontSize: 10, marginTop: 4, opacity: 0.7 }}>compressées en webp 95%</div>\n   466\t      </div>\n   467\t      {card.images && card.images.length > 0 && (\n   468\t        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2,1fr)', gap: 8, marginTop: 12 }}>\n   469\t          {card.images.map((src, i) => (\n   470\t            <div key={i} style={{ position: 'relative' }}>\n   471\t              <img src={src} alt=\"\" style={{ width: '100%', borderRadius: RADII.sm, display: 'block', border: `1px solid ${t.border}` }} />\n   472\t              <button onClick={() => removeImage(card.id, i)} style={{ position: 'absolute', top: 4, right: 4, background: 'rgba(0,0,0,0.6)', color: '#fff', border: 'none', borderRadius: 99, width: 22, height: 22, cursor: 'pointer' }}>×</button>\n   473\t            </div>\n   474\t          ))}\n   475\t        </div>\n   476\t      )}\n   477\t      <button onClick={() => delCard(card.id)} style={{ ...btn(t), color: PALETTE.red, borderColor: PALETTE.red, marginTop: 22 }}>Supprimer la carte</button>\n   478\t    </aside>\n   479\t  )\n   480\t}\n   481\t\n   482\t/* ───────── Archive (cartes par mois) ───────── */\n   483\tfunction Archive({ t, cards, onOpen }) {\n   484\t  const [view, setView] = useState('gallery')\n   485\t  const sorted = [...cards].sort((a, b) => (a.date < b.date ? 1 : -1))\n   486\t  const groups = {}\n   487\t  sorted.forEach((c) => { const k = monthKey(c.date); (groups[k] = groups[k] || []).push(c) })\n   488\t  const keys = Object.keys(groups)\n   489\t  const toItem = (c) => ({ id: c.id, title: c.title, subtitle: c.domain, image: c.images && c.image